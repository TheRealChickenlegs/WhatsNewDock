# Example nginx reverse-proxy configuration for exposing WhatsNewDock behind
# a domain, e.g. https://whatsnewdock.example.com.
#
# Place in /etc/nginx/conf.d/whatsnewdock.conf and reload nginx.
# The upstream WhatsNewDock server should set:
#   WND_BASE_URL=https://whatsnewdock.example.com
#   WND_TRUSTED_PROXIES=<nginx IP or CIDR>

server {
    listen 443 ssl http2;
    server_name whatsnewdock.example.com;

    # --- TLS (adjust to your certificate paths) ---------------------------
    ssl_certificate     /etc/letsencrypt/live/whatsnewdock.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whatsnewdock.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 120s;
    }
}

# Redirect plain HTTP to HTTPS.
server {
    listen 80;
    server_name whatsnewdock.example.com;
    return 301 https://$host$request_uri;
}
